# Pick ONE provider. The key stays on the server (server/index.js) and never reaches the browser.
PROVIDER=gemini          # gemini | anthropic | openai  (openai = any OpenAI-compatible API: Groq, OpenRouter, Ollama...)

# --- Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI-compatible (Groq / OpenRouter / Ollama) ---
OPENAI_BASE_URL=https://api.groq.com/openai/v1   # Ollama: http://localhost:11434/v1
OPENAI_API_KEY=                                  # Ollama: any non-empty string
OPENAI_MODEL=llama-3.3-70b-versatile             # Ollama: e.g. llama3.2

PORT=3001
